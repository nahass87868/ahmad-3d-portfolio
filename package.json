{
  "name": "ahmad-nahass-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ahmad Nahass — 3D artist portfolio. Vite + TypeScript, prerendered to static HTML.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run media:check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "media:check": "node scripts/check-media.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
